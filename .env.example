# Copy to .env and fill in. .env is gitignored and must never be committed.
# In CI these are GitHub Actions secrets, not a file.

# --- Passage selection -------------------------------------------------------
# Google AI Studio key. The free tier allows 20 requests per day PER MODEL,
# which is why config.toml lists five models as a quota pool rather than a
# simple failover chain.
GEMINI_API_KEY=

# --- Email -------------------------------------------------------------------
# A Gmail app password, used both to SEND the briefing and to READ the inbox
# for the Politico layer. This is the most over-privileged credential in the
# system: unscoped, no expiry, read and send. Dropping the Politico layer
# removes the need for mailbox read access entirely.
GMAIL_APP_PASSWORD=
BRIEFING_FROM=
BRIEFING_TO=

# --- Storage -----------------------------------------------------------------
# Working copy of the private archive repository (transcripts, news, state).
# Point this at a SCRATCH directory when testing locally — a test run writes
# state and would otherwise mark real episodes as processed.
ARCHIVE_DIR=../podcast-archive

# --- Monitoring (optional) ---------------------------------------------------
# Healthchecks.io dead-man's-switch URLs. Omit locally; the run skips the ping
# and says so. Daily briefing and weekly Constituency Watch have separate
# checks.
HEALTHCHECK_URL=
HEALTHCHECK_URL_WEEKLY=
